# Copy to .env for local runs. In GitHub: Settings → Secrets and variables → Actions → New repository secret.

# Meta (Facebook + Instagram) — see README step 3
META_APP_ID=
META_APP_SECRET=
FB_PAGE_ID=
IG_USER_ID=
PAGE_ACCESS_TOKEN=

# Telegram approval bot — see README step 5
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public media bucket (Cloudflare R2 or any S3-compatible) — see README step 4
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=engiformula-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
PUBLIC_MEDIA_BASE_URL=https://media.engiformula.com

# Testing: DRY_RUN=1 prints every API call instead of sending it
DRY_RUN=0
